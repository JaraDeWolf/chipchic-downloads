{
  "name": "chipchic-desktop",
  "productName": "ChipChic",
  "desktopName": "chipchic.desktop",
  "version": "2.5.0",
  "description": "ChipChic for Windows, Mac and Linux: a window that opens your ChipChic website",
  "main": "main.js",
  "author": "ChipChic",
  "private": true,
  "scripts": {
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.chipper.desktop",
    "productName": "ChipChic",
    "files": [
      "main.js",
      "preload.js",
      "loading.html",
      "bubble.html",
      "bubble-preload.js",
      "settings.json",
      "icons/**"
    ],
    "directories": {
      "output": "dist"
    },
    "afterPack": "build/after-pack.js",
    "win": {
      "target": "nsis",
      "icon": "icons/icon.png",
      "artifactName": "ChipChic-Setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "icons/icon.png",
      "category": "public.app-category.social-networking",
      "artifactName": "ChipChic-Mac.dmg",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "ChipChic uses the microphone for voice calls and voice channels.",
        "NSCameraUsageDescription": "ChipChic uses the camera for video calls and taking photos."
      }
    },
    "dmg": {
      "title": "ChipChic"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/icon.png",
      "category": "Network",
      "synopsis": "Chat with your friends and servers",
      "artifactName": "ChipChic-Linux.AppImage",
      "syncDesktopName": true
    }
  }
}
